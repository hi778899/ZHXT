# 生产环境请复制为 .env，并替换所有示例值
NODE_ENV=production
PORT=8787
# 国内网络或内网部署时，可改成镜像仓库中的完整镜像地址。
# 例如：<your-registry>/library/node:22-alpine、<your-registry>/library/postgres:16-alpine
NODE_BASE_IMAGE=node:22-alpine
# Node/Corepack/pnpm 依赖下载仓库。当前默认使用 npmmirror，解决部分服务器访问 registry.npmjs.org 超时。
# 如可直接访问官方 npm，可改为 https://registry.npmjs.org；企业内网也可填写内部 npm 镜像。
NPM_REGISTRY=https://registry.npmmirror.com
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_PASSWORD=replace-this-password
DATABASE_URL=postgres://cockpit:replace-this-password@db:5432/cockpit
DATABASE_SSL=false
DB_POOL_MAX=20
SESSION_HOURS=8
COOKIE_SECURE=false
RESET_TOKEN_MINUTES=10
WEB_ORIGIN=http://localhost:8787
INITIAL_ADMIN_USERNAME=zhangshan
INITIAL_ADMIN_NAME=张珊
INITIAL_ADMIN_DEPARTMENT=设备管理部
INITIAL_ADMIN_PASSWORD=ChangeMe123!
# production 时不在接口返回验证码；请接入短信/邮件服务后由服务端发送
RESET_CODE_MODE=provider

# 请休假独立审批模型默认办理账号（首次启动脚本会生成随机密码）
DEPARTMENT_MANAGER_USERNAME=deptmanager
DEPARTMENT_MANAGER_NAME=部门经理
DEPARTMENT_MANAGER_DEPARTMENT=设备管理部
DEPARTMENT_MANAGER_PASSWORD=replace-this-password
ATTENDANCE_SUPERVISOR_USERNAME=attendance
ATTENDANCE_SUPERVISOR_NAME=考勤主管
ATTENDANCE_SUPERVISOR_DEPARTMENT=组织人事部
ATTENDANCE_SUPERVISOR_PASSWORD=replace-this-password

# 0622案例人员统一初始密码；用户名为员工数字化编码，首次登录后请修改。
CASE_USER_INITIAL_PASSWORD=replace-this-password

# 文件名时间码使用的业务时区
BUSINESS_TIMEZONE=Asia/Shanghai
